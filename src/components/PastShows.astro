---
import type { Show } from './UpcomingShows.astro';

interface Props {
  locale: 'he' | 'en';
  heading: string;
  shows: Show[];
}
const { locale, heading, shows } = Astro.props;

const past = shows.filter((s) => s.status === 'past');

// Real event posters (saved by the user from Facebook), used purely as a
// decorative collage — deliberately not mapped 1:1 to entries in `shows`.
// See docs/superpowers/specs/2026-08-11-content-refinements-design.md for
// why linking was dropped. Rendered as a masonry that preserves each
// poster's native aspect ratio — no forced square cropping, since the
// poster artwork itself (band name, date, venue, main visual) needs to
// stay fully visible and legible.
const posters = [
  'poster-bar-giyora-stardust.jpg',
  'poster-tassa.jpg',
  'poster-bella-ciao-eggroll-tour.jpg',
  'poster-ba-be-bar.jpg',
  'poster-hobbit-bar.jpg',
  'poster-babity-valentines.jpg',
  'poster-beit-hamarzeach.jpg',
  'poster-bella-ciao-jul2024.jpg',
  'poster-traklin.jpg',
  'poster-mishmarot.jpg',
  'poster-pub-hapara.jpg',
];

function formatDate(iso: string, locale: 'he' | 'en') {
  return new Date(iso).toLocaleDateString(locale === 'he' ? 'he-IL' : 'en-GB', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}
---

<section id="past-shows" class="past has-grain">
  <h2 class="past__heading">{heading}</h2>

  <div class="past__collage" data-past-collage>
    {posters.map((p) => (
      <div class="past__poster-cell" data-past-poster>
        <img src={`/assets/posters/${p}`} alt="" loading="lazy" class="past__poster-img" />
      </div>
    ))}
  </div>

  <ul class="past__list" data-past-list>
    {past.map((s) => (
      <li class="past__row" data-past-row>
        <span class="past__date label">{formatDate(s.dateISO, locale)}</span>
        <span class="past__venue">{locale === 'he' ? s.venueHe : s.venueEn}</span>
        <span class="past__city label">{locale === 'he' ? s.cityHe : s.cityEn}</span>
      </li>
    ))}
  </ul>
</section>

<noscript>
  <style is:global>
    #past-shows .past__poster-cell,
    #past-shows .past__row {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style>
  .past {
    background: var(--color-black);
    padding: var(--space-xl) var(--space-md);
  }

  .past__heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    text-align: center;
    margin: 0 0 var(--space-lg);
    opacity: 0.85;
  }

  /* Collage: a real masonry (CSS multi-column), not a grid — this is
     deliberate. A grid with fixed cell aspect ratios forces every poster
     into the same crop regardless of whether it's square or landscape,
     which cuts off band name / date / venue / ticket info on some of them.
     Columns let each <img> render at its natural width:auto height, so
     square posters stay square and landscape posters stay landscape.
     Purely decorative, no captions, no links. */
  .past__collage {
    column-count: 3;
    column-gap: var(--space-xs);
    max-width: 64rem;
    margin: 0 auto var(--space-lg);
  }

  .past__poster-cell {
    break-inside: avoid;
    margin-bottom: var(--space-xs);
    opacity: 0;
    transform: translateY(16px);
  }

  .past__poster-img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(0.3);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .past__poster-cell:hover .past__poster-img {
      filter: grayscale(0);
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .past__poster-cell {
      opacity: 1;
      transform: none;
    }
    .past__poster-img {
      transition: none;
    }
  }

  @media (max-width: 699px) {
    .past__collage {
      column-count: 2;
    }
  }

  /* Chronological list */
  .past__list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 40rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
  }

  .past__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-sm);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--color-charcoal);
    opacity: 0;
    transform: translateY(8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .past__row {
      opacity: 1;
      transform: none;
    }
  }

  .past__venue {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--size-body);
  }

  @media (max-width: 480px) {
    .past__row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion } from '../scripts/reduced-motion';

  gsap.registerPlugin(ScrollTrigger);

  const posterCells = gsap.utils.toArray('[data-past-poster]') as HTMLElement[];
  const rows = gsap.utils.toArray('[data-past-row]') as HTMLElement[];

  if (prefersReducedMotion()) {
    [...posterCells, ...rows].forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  } else {
    gsap.to(posterCells, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      stagger: 0.05,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '[data-past-collage]',
        start: 'top 85%',
      },
    });

    gsap.to(rows, {
      opacity: 1,
      y: 0,
      duration: 0.3,
      stagger: 0.02,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '[data-past-list]',
        start: 'top 90%',
      },
    });

    if ('fonts' in document) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
  }
</script>
