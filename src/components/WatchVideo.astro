---
interface Props {
  heading: string;
  youtubeId: string;
}
const { heading, youtubeId } = Astro.props;
---

<section id="watch" class="watch has-grain">
  <h2 class="watch__heading">{heading}</h2>
  <div class="watch__frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title="Stardust — David Bowie Tribute"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</section>

<noscript>
  <style is:global>
    #watch .watch__heading,
    #watch .watch__frame {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style>
  .watch {
    background: var(--color-black);
    padding: var(--space-xl) var(--space-md);
  }

  .watch__heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    text-align: center;
    margin: 0 0 var(--space-lg);
    opacity: 0;
    transform: translateY(16px);
  }

  .watch__frame {
    position: relative;
    max-width: 56rem;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    background: var(--color-charcoal);
    opacity: 0;
    transform: translateY(16px);
  }

  .watch__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .watch__heading,
    .watch__frame {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion } from '../scripts/reduced-motion';

  gsap.registerPlugin(ScrollTrigger);

  const targets = [
    document.querySelector('.watch__heading'),
    document.querySelector('.watch__frame'),
  ] as HTMLElement[];

  if (!prefersReducedMotion()) {
    gsap.to(targets, {
      opacity: 1,
      y: 0,
      duration: 0.7,
      stagger: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#watch',
        start: 'top 80%',
      },
    });

    if ('fonts' in document) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
  }
</script>
