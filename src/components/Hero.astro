---
// logo-layout.json is written by scripts/prepare-stardust-logo.mjs: where the
// (tight-cropped) logo sits inside the larger dust frame. The dust layer is
// positioned/sized relative to the logo box from these numbers, so the two
// layers line up exactly like the original artwork.
import layout from '../content/logo-layout.json';

interface Props {
  subtitle: string;
  tribute: string;
  descriptor: string;
}
const { subtitle, tribute, descriptor } = Astro.props;

const dustStyle = [
  `--dust-left:${(layout.dustLeftOfLogo * 100).toFixed(3)}%`,
  `--dust-top:${(layout.dustTopOfLogo * 100).toFixed(3)}%`,
  `--dust-w:${(layout.dustWidthOfLogo * 100).toFixed(3)}%`,
  `--dust-ratio:${(1 / layout.dustAspect).toFixed(5)}`,
].join(';');
---

<section id="hero" class="hero has-grain">
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__bg-video"
      data-hero-bg-video
      poster="/assets/hero/hero-band-live.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/assets/hero/hero-bg-video.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__brand" style={dustStyle}>
    <div class="hero__dust-layer" aria-hidden="true">
      <img class="hero__dust" src="/assets/logo/stardust-dust.webp" alt="" />
      <canvas class="hero__sparkles" data-hero-sparkles data-logo-box={JSON.stringify(layout.logoInDust)}></canvas>
    </div>
    <h1 class="hero__logo-wrap">
      <img
        src="/assets/logo/stardust-logo.png"
        alt={subtitle}
        class="hero__logo"
        data-hero-logo
      />
    </h1>
  </div>
  <p class="hero__tribute" data-hero-tribute>{tribute}</p>
  <p class="hero__descriptor" data-hero-descriptor>{descriptor}</p>
</section>

<noscript>
  <style is:global>
    #hero .hero__logo,
    #hero .hero__tribute,
    #hero .hero__descriptor,
    #hero .hero__dust-layer,
    #hero .hero__bg-video {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style>
  .hero {
    position: relative;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: var(--color-black);
  }

  .hero__bg {
    position: absolute;
    inset: -5%;
    z-index: 0;
    overflow: hidden;
  }

  .hero__bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: grayscale(0.3) contrast(1.1);
    opacity: 0;
    transform: scale(1.15);
    will-change: transform;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0.75) 55%, var(--color-black) 100%),
      radial-gradient(ellipse at center, transparent 0%, rgba(10, 10, 10, 0.4) 100%);
  }

  /* The brand block is the logo's box; the dust layer is positioned relative
     to it (see --dust-* vars, generated from the artwork) and may extend past
     it — the hero clips overflow. */
  .hero__brand {
    position: relative;
    z-index: 1;
    width: min(88vw, 640px);
    margin: 0 0 var(--space-md);
    direction: ltr;
  }

  .hero__logo-wrap {
    position: relative;
    z-index: 1;
    margin: 0;
    line-height: 0;
  }

  .hero__logo {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Dust + sparkles: the galaxy streak and little stars from the original
     artwork, kept as their own layer BEHIND the lettering. */
  .hero__dust-layer {
    position: absolute;
    z-index: 0;
    left: var(--dust-left);
    top: var(--dust-top);
    width: var(--dust-w);
    aspect-ratio: var(--dust-ratio);
    pointer-events: none;
    opacity: 0;
    animation: dust-drift 16s ease-in-out infinite alternate;
  }

  .hero__dust {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__sparkles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @keyframes dust-drift {
    from {
      transform: translate3d(-0.6%, 0.4%, 0) scale(1);
    }
    to {
      transform: translate3d(0.8%, -0.6%, 0) scale(1.025);
    }
  }

  /* Tier 2: the identity-clarifying line. Bold and tracked, in the same
     accent-orange as the logo's own lightning bolt — deliberately NOT a
     small footnote-style label, since its whole job is telling a
     first-time visitor "this is a David Bowie tribute band" before
     anything else on the page does. */
  .hero__tribute {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent-orange);
    margin: 0;
  }

  /* Tier 3: the fuller hero statement — clearly legible but subordinate to
     the tribute line above it. */
  .hero__descriptor {
    position: relative;
    z-index: 1;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.05rem, 2.6vw, 1.4rem);
    color: var(--color-off-white);
    opacity: 0.85;
    margin: var(--space-sm) 0 0;
  }

  .hero__logo,
  .hero__tribute,
  .hero__descriptor {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logo,
    .hero__tribute,
    .hero__descriptor,
    .hero__dust-layer,
    .hero__bg-video {
      opacity: 1;
      transform: none;
    }
    .hero__dust-layer {
      animation: none;
    }
    .hero__sparkles {
      display: none;
    }
    .hero__descriptor {
      opacity: 0.85;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { prefersReducedMotion } from '../scripts/reduced-motion';
  import { startSparkles, type LogoBox } from '../scripts/sparkles';

  const bgVideo = document.querySelector('[data-hero-bg-video]') as HTMLVideoElement | null;

  if (prefersReducedMotion()) {
    // Motion-sensitive visitors get the static poster frame, not the
    // looping clip — pause it (the poster still renders as a still image)
    // rather than leaving a moving background running against their
    // stated preference.
    bgVideo?.pause();
  } else {
    // autoplay/muted/loop/playsinline on the element already start
    // playback without JS; this call just guards against browsers that
    // silently ignore the attribute (or a prior pause from a reduced-
    // motion toggle elsewhere) — play() on an already-playing video is a
    // harmless no-op.
    bgVideo?.play().catch(() => {
      // Autoplay can still be blocked in some environments even when
      // muted; the poster frame is a perfectly fine fallback, so there's
      // nothing to recover here.
    });

    // Use fromTo() rather than from() here: the CSS baseline for these elements is
    // opacity:0 (the site's standard hidden-until-revealed pattern), and from() treats
    // the element's current computed style as its implicit "to" state — which would
    // resolve to opacity:0 and leave the reveal invisible. fromTo() makes the opacity:1
    // destination explicit, matching the pattern used in Story.astro/FinalScene.astro.
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.to(bgVideo, { opacity: 1, scale: 1.05, duration: 1.6, ease: 'power2.out' })
      .fromTo('.hero__logo', { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 1.1 }, '-=1.2')
      .fromTo('.hero__dust-layer', { opacity: 0 }, { opacity: 1, duration: 1.8, ease: 'power1.out' }, '-=0.7')
      .fromTo('.hero__tribute', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.4')
      .fromTo(
        '.hero__descriptor',
        { opacity: 0, y: 16 },
        { opacity: 0.85, y: 0, duration: 0.6 },
        '-=0.3'
      );

    const sparkleCanvas = document.querySelector('[data-hero-sparkles]') as HTMLCanvasElement | null;
    if (sparkleCanvas?.dataset.logoBox) {
      startSparkles(sparkleCanvas, JSON.parse(sparkleCanvas.dataset.logoBox) as LogoBox);
    }

    const supportsHoverParallax = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (supportsHoverParallax && bgVideo) {
      const hero = document.getElementById('hero');

      hero?.addEventListener('mousemove', (event) => {
        const rect = hero.getBoundingClientRect();
        const relativeX = (event.clientX - rect.left) / rect.width - 0.5;
        const relativeY = (event.clientY - rect.top) / rect.height - 0.5;

        gsap.to(bgVideo, {
          x: relativeX * -20,
          y: relativeY * -20,
          duration: 0.8,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      });

      hero?.addEventListener('mouseleave', () => {
        gsap.to(bgVideo, { x: 0, y: 0, duration: 0.6, ease: 'power2.out', overwrite: 'auto' });
      });
    }
  }
</script>
