---
interface Props {
  locale: 'he' | 'en';
  heading: string;
  subheading: string;
  introParagraph: string;
}
const { locale, heading, subheading, introParagraph } = Astro.props;
---

<section id="band-gallery" class="gallery has-grain">
  <h2 class="gallery__heading">{heading}</h2>
  <p class="gallery__subheading">{subheading}</p>
  <p class="gallery__intro">{introParagraph}</p>

  <div class="gallery__grid" data-gallery-grid>
    <div class="gallery__cell gallery__cell--dominant" data-gallery-cell>
      <img
        src="/assets/gallery/gallery-band-01.jpg"
        alt={locale === 'he' ? 'YADAYADAS על הבמה' : 'YADAYADAS live on stage'}
        loading="lazy"
        class="gallery__image"
      />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-02.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-03.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-04.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-05.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-06.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-07.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-08.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-09.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-10.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-11.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
    <div class="gallery__cell" data-gallery-cell>
      <img src="/assets/gallery/gallery-band-12.jpg" alt="" loading="lazy" class="gallery__image" />
    </div>
  </div>
</section>

<noscript>
  <style is:global>
    #band-gallery .gallery__cell {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style>
  .gallery {
    background: var(--color-black);
    padding: var(--space-xl) var(--space-md) var(--space-md);
  }

  .gallery__heading,
  .gallery__subheading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    text-align: center;
    margin: 0;
  }

  .gallery__intro {
    max-width: 42rem;
    margin: var(--space-md) auto var(--space-lg);
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--size-body);
    line-height: 1.6;
    color: var(--color-off-white);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 20vh;
    grid-auto-flow: dense;
    gap: var(--space-xs);
    max-width: 64rem;
    margin-inline: auto;
  }

  .gallery__cell {
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
  }

  .gallery__cell--dominant {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery__cell:hover .gallery__image {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__cell {
      opacity: 1;
      transform: none;
    }
    .gallery__image {
      transition: none;
    }
  }

  /* Mobile: dominant image stays full-width and tall; supporting images
     become a 2-across grid beneath it, rather than a naive uniform stack. */
  @media (max-width: 699px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      /* minmax(20vh, auto), not a fixed 20vh: a fixed row height works for
         the supporting cells (their image has no intrinsic height, so the
         row just sizes to the 20vh minimum), but the dominant cell's
         height is driven by its own aspect-ratio below and varies with the
         source photo. A fixed-height row silently clips/overflows whenever
         that content is taller than one row track; minmax's auto upper
         bound lets the row grow to fit instead. */
      grid-auto-rows: minmax(20vh, auto);
    }
    .gallery__cell--dominant {
      /* Explicitly cancel the desktop rule's `grid-row: span 2` here: the
         cell's mobile height is driven entirely by aspect-ratio below, so
         spanning fixed 20vh rows on top of that reserved more grid height
         than the image actually filled and left a dead gap before the next
         row. Without this override the base (non-media-query) rule still
         applies at every viewport width. */
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
      height: auto;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion } from '../scripts/reduced-motion';

  gsap.registerPlugin(ScrollTrigger);

  const cells = gsap.utils.toArray('[data-gallery-cell]') as HTMLElement[];

  if (prefersReducedMotion()) {
    cells.forEach((c) => {
      c.style.opacity = '1';
      c.style.transform = 'none';
    });
  } else {
    gsap.to(cells, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '[data-gallery-grid]',
        start: 'top 80%',
      },
    });

    if ('fonts' in document) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
  }
</script>
