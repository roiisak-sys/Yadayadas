---
// Fixed brand mark, mirrors LanguageToggle's fixed corner placement on the
// opposite side. Links back to the top of the page.
---

<a href="#hero" id="brand-mark" aria-label="Stardust">
  <img src="/assets/logo/stardust-logo.png" alt="Stardust" />
</a>

<style>
  #brand-mark {
    position: fixed;
    top: var(--space-xs);
    inset-inline-start: var(--space-xs);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Visual mark is small (22-28px), but the tap target needs to meet the
       ~44px touch-target minimum — padding expands the hit area without
       growing the logo itself. */
    min-height: 44px;
    min-width: 44px;
    padding: var(--space-xs);
    box-sizing: border-box;
  }

  #brand-mark img {
    height: 22px;
    width: auto;
    display: block;
  }

  @media (min-width: 700px) {
    #brand-mark img {
      height: 28px;
    }
  }
</style>
