---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/BrandMark.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import Hero from '../../components/Hero.astro';
import BowieCollage from '../../components/BowieCollage.astro';
import WhyStatement from '../../components/WhyStatement.astro';
import MusicStartsAndBand from '../../components/MusicStartsAndBand.astro';
import Sound from '../../components/Sound.astro';
import Story from '../../components/Story.astro';
import EditorialQuotes from '../../components/EditorialQuotes.astro';
import Events from '../../components/Events.astro';
import type { ShowEvent } from '../../components/Events.astro';
import FinalScene from '../../components/FinalScene.astro';
import copy from '../../content/copy.en.json';
import bandMembers from '../../content/band-members.json';
import storyBeats from '../../content/story-beats.json';
import eventsData from '../../content/events.json';

const events = eventsData as ShowEvent[];
---

<BaseLayout locale="en" title={copy.meta.title} description={copy.meta.description}>
  <BrandMark />
  <LanguageToggle locale="en" label={copy.languageToggle.label} ariaLabel={copy.languageToggle.ariaLabel} />
  <main>
    <Hero
      question={copy.hero.question}
      title={copy.hero.title}
      subtitle={copy.hero.subtitle}
      descriptor={copy.hero.descriptor}
      tagline={copy.hero.tagline}
    />
    <BowieCollage
      locale="en"
      heading={copy.question.heading}
      fragments={copy.question.fragments}
      eras={copy.bowies.eras}
    />
    <WhyStatement
      line1={copy.why.line1}
      line2={copy.why.line2}
      line3={copy.why.line3}
      line4={copy.why.line4}
    />
    <MusicStartsAndBand
      locale="en"
      label={copy.musicStarts.label}
      heading={copy.band.heading}
      subheading={copy.band.subheading}
      intro={copy.band.intro}
      members={bandMembers.filter((m) => m.role === 'core')}
    />
    <Sound words={copy.sound.words} />
    <Story locale="en" heading={copy.story.heading} beats={storyBeats} />
    <EditorialQuotes quote={copy.quotes.primary} />
    <Events
      locale="en"
      heading={copy.events.heading}
      emptyLabel={copy.events.empty}
      ticketsCta={copy.events.ticketsCta}
      events={events}
    />
    <FinalScene
      line1={copy.final.line1}
      line2={copy.final.line2}
      contactHeading={copy.contact.heading}
      whatsappCta={copy.contact.whatsappCta}
      whatsappNumber={copy.contact.whatsappNumber}
      whatsappMessage={copy.contact.whatsappMessage}
      instagramUrl={copy.contact.instagramUrl}
      facebookUrl={copy.contact.facebookUrl}
      youtubeUrl={copy.contact.youtubeUrl}
    />
  </main>
</BaseLayout>
